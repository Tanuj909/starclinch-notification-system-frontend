{
  "headers": [
    {
      "source": "/OneSignalSDKWorker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/OneSignalSDKWorker.js",
      "destination": "/OneSignalSDKWorker.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
